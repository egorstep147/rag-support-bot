# Скопируйте в .env и заполните. .env не коммитится.

BOT_TOKEN=
# Компания: папка в companies/ (provider, school или своя)
COMPANY=provider
# PostgreSQL с pgvector. docker compose: postgresql://support:ПАРОЛЬ@127.0.0.1:5435/support
DATABASE_URL=
POSTGRES_PASSWORD=
# Telegram ID админов (загрузка файлов, /stats, /gaps)
ADMIN_IDS=
# Группа операторов с темами: создайте группу, включите «Темы», добавьте бота админом
# («Управление темами»). ID группы вида -100… — перешлите сообщение из неё боту @userinfobot
OPERATOR_CHAT_ID=

# --- Модели ---
# gemini | anthropic | openai (openai — также OpenRouter, DeepSeek, локальная Ollama)
LLM_PROVIDER=gemini
# Бесплатный тариф: у gemini-flash-latest всего 20 запросов в день, у lite свой лимит (смотреть: AI Studio → Rate Limit)
MODEL_SMART=gemini-flash-lite-latest
MODEL_FAST=gemini-flash-lite-latest
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
EMBED_PROVIDER=gemini
EMBED_MODEL=gemini-embedding-001
# Длина вектора — задаётся до первой миграции (Gemini: 768, bge-m3 в Ollama: 1024)
EMBED_DIM=768
STT_PROVIDER=gemini

# Полностью локально (без ключей), через Ollama:
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=http://localhost:11434/v1
# MODEL_SMART=gemma4:e4b-it-qat
# MODEL_FAST=gemma4:e4b-it-qat
# EMBED_PROVIDER=openai
# EMBED_MODEL=bge-m3
# EMBED_DIM=1024

# --- Источники ---
# Google Docs: JSON-ключ сервисного аккаунта (папки Drive открыты на его email)
GOOGLE_CREDENTIALS_FILE=
# Notion: токен внутренней интеграции, страницы открыты для неё
NOTION_TOKEN=

# --- Сервис ---
# Публичный HTTPS-адрес (для виджета на сайте и вебхука)
PUBLIC_URL=
# Сайты, где разрешено встраивать виджет, через запятую; пусто — любые
WIDGET_ORIGINS=
WEBHOOK_URL=
WEBHOOK_SECRET=
POLLING=true
HOST=127.0.0.1
PORT=8086
